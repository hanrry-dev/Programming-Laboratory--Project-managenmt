    {
      "id": "ugCSN1fMYkHa6fg09FSKg",
      "type": "text",
      "x": 2074.087883641332,
      "y": 346.71505495826034,
      "width": 600.1795654296875,
      "height": 200,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "#fcc2d7",
      "fillStyle": "solid",
      "strokeWidth": 2,
